<?xml version="1.0"?>
<sdf version="1.9">
  <world name="nlp_phase2_lab">
    <gravity>0 0 -9.8</gravity>
    <physics name="1ms" type="ignored">
      <max_step_size>.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <scene>
      <ambient>.48 .50 .54 1</ambient>
      <background>.17 .20 .26 1</background>
      <shadows>true</shadows>
    </scene>
    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>.48 .50 .54</ambient_light>
        <background_color>.17 .20 .26</background_color>
        <camera_pose>10 -12 12 0 .655 2.2655</camera_pose>
        <camera_clip>
          <near>.05</near>
          <far>200</far>
        </camera_clip>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="width">5</property>
          <property type="double" key="height">5</property>
          <property type="string" key="state">floating</property>
          <property type="bool" key="showTitleBar">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="width">5</property>
          <property type="double" key="height">5</property>
          <property type="string" key="state">floating</property>
          <property type="bool" key="showTitleBar">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left" />
            <line own="bottom" target="bottom" />
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
        <service>/world/nlp_phase2_lab/control</service>
        <stats_topic>/world/nlp_phase2_lab/stats</stats_topic>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">100</property>
          <property type="double" key="width">280</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right" />
            <line own="bottom" target="bottom" />
          </anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <topic>/world/nlp_phase2_lab/stats</topic>
      </plugin>
      <plugin filename="EntityTree" name="Entity tree" />
    </gui>
    <light name="soft_daylight" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>.78 .80 .85 1</diffuse>
      <specular>.15 .15 .15 1</specular>
      <direction>-.45 .35 -1</direction>
    </light>
    <light name="home_fill" type="point">
      <pose>-3 1 4 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.72 0.85 0.78 1</diffuse>
      <specular>.1 .1 .1 1</specular>
      <attenuation>
        <range>12</range>
        <constant>0.8</constant>
        <linear>0.03</linear>
        <quadratic>0.008</quadratic>
      </attenuation>
    </light>
    <light name="lab_fill" type="point">
      <pose>3 1 4 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.76 0.83 0.98 1</diffuse>
      <specular>.1 .1 .1 1</specular>
      <attenuation>
        <range>12</range>
        <constant>0.8</constant>
        <linear>0.03</linear>
        <quadratic>0.008</quadratic>
      </attenuation>
    </light>
