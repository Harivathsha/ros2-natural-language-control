    <plugin filename="gz-sim-linearbatteryplugin-system" name="gz::sim::systems::LinearBatteryPlugin">
      <battery_name>linear_battery</battery_name>
      <voltage>12.0</voltage>
      <open_circuit_voltage_constant_coef>12.0</open_circuit_voltage_constant_coef>
      <capacity>2.5</capacity>
      <initial_charge>2.5</initial_charge>
      <power_load>15.0</power_load> 
    </plugin>
  </gazebo> -->
  
</robot>